@model ParticipantEditEnrollmentViewModel
@{
    ViewData["Title"] = "Edit Enrolment";
}

<h1 class="page-title">Edit Enrolment</h1>
<p class="page-subtitle">Update your category selection for this upcoming event.</p>

<div class="card panel">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label class="form-label">Event</label>
            <div class="form-control-plaintext">@Model.EventName</div>
            <div class="text-muted">@Model.EventDate.ToString("dddd, dd MMM yyyy HH:mm") · @Model.Location</div>
        </div>

        <form asp-action="EditEnrolment" method="post" data-prevent-double-submit="true">
            @Html.AntiForgeryToken()
            <input asp-for="EnrollmentID" type="hidden" />
            <input asp-for="EventID" type="hidden" />

            @if (!Model.CategoryOptions.Any())
            {
                <div class="alert alert-warning" role="alert">
                    Categories could not be loaded for this event. Please try again later.
                </div>
            }

            <div class="mb-3">
                <label asp-for="CategoryID" class="form-label">Category</label>
                <select asp-for="CategoryID" asp-items="Model.CategoryOptions" class="form-select" required aria-describedby="categoryHelp">
                    <option value="" disabled selected>Select category</option>
                </select>
                <div id="categoryHelp" class="form-text">Only categories available for this event are listed.</div>
                <span asp-validation-for="CategoryID" class="text-danger"></span>
            </div>

            <button class="btn btn-primary" type="submit" data-submit-text="Saving..." disabled="@(!Model.CategoryOptions.Any())">Save</button>
            <a class="btn btn-outline-secondary" asp-action="MyEnrolments">Cancel</a>
            <a class="btn btn-link" asp-action="UpcomingEvents">Back to events</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
