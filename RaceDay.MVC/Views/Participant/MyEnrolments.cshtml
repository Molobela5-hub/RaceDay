@model List<ParticipantEnrollmentRowViewModel>
@{
    ViewData["Title"] = "My Enrolments";
}

<h1 class="page-title">My Enrolments</h1>
<p class="page-subtitle">Manage your race enrolments and make changes before events start.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">You do not have any enrolments.</div>
}
else
{
    <div class="table-responsive surface-table">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Enrolled</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EventName<br/><small class="text-muted">@item.Location</small></td>
                        <td>@item.EventDate.ToString("g")</td>
                        <td>@item.CategoryName</td>
                        <td>@item.EnrollmentDate.ToString("g")</td>
                        <td>
                            @if (item.CanEdit)
                            {
                                <a class="btn btn-outline-primary btn-sm" asp-action="EditEnrolment" asp-route-id="@item.EnrollmentID">Edit</a>
                            }
                            <form asp-action="CancelEnrolment" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.EnrollmentID" />
                                <button class="btn btn-outline-danger btn-sm" type="submit" onclick="return confirm('Are you sure you want to cancel this enrolment?');">Cancel</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
